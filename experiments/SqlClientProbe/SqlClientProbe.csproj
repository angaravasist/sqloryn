<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="[7.1.1]" />
    <!-- Pin the security fix until SqlClient's minimum dependency includes it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[10.0.14]" />
    <!-- Unix uses managed networking; do not copy the separately licensed Windows native SNI binaries. -->
    <PackageReference Include="Microsoft.Data.SqlClient.SNI.runtime" Version="[7.1.0]" ExcludeAssets="all" PrivateAssets="all" />
    <InternalsVisibleTo Include="SqlClientProbe.Tests" />
  </ItemGroup>
</Project>
