<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sqloryn.ConnectWindow"
        Title="Connect — SQLoryn"
        Width="500" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="10">
      <TextBlock Text="Connect to SQL Server" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Classes="muted"
                 Text="SQL authentication · encryption mandatory · password lives in memory unless you choose Remember."
                 TextWrapping="Wrap" />

      <TextBlock Classes="caption" Text="RECENT PROFILE" Margin="0,6,0,0" />
      <ComboBox Name="ProfileBox" HorizontalAlignment="Stretch"
                PlaceholderText="(new connection)"
                AutomationProperties.Name="Recent profile"
                SelectionChanged="OnProfileChanged" />

      <TextBlock Classes="caption" Text="SERVER" Margin="0,6,0,0" />
      <Grid ColumnDefinitions="*,92" ColumnSpacing="8">
        <TextBox Name="ServerBox" TextChanged="OnEndpointTextChanged" PlaceholderText="Server host" AutomationProperties.Name="Server" />
        <TextBox Name="PortBox" TextChanged="OnEndpointTextChanged" Grid.Column="1" PlaceholderText="Port" Text="1433" AutomationProperties.Name="Port" />
      </Grid>
      <TextBox Name="DatabaseBox" PlaceholderText="Database" Text="master" AutomationProperties.Name="Database" />

      <TextBlock Classes="caption" Text="CREDENTIALS" Margin="0,6,0,0" />
      <TextBox Name="UserBox" TextChanged="OnEndpointTextChanged" PlaceholderText="Login" AutomationProperties.Name="Login" />
      <TextBox Name="PasswordBox" TextChanged="OnPasswordTextChanged" PlaceholderText="Password" PasswordChar="•"
               AutomationProperties.Name="Password" />

      <TextBlock Classes="caption" Text="TLS" Margin="0,6,0,0" />
      <CheckBox Name="TrustBox" IsCheckedChanged="OnEndpointCheckChanged" Content="Trust server certificate (lab only — skips CA/name checks)"
                AutomationProperties.Name="Trust server certificate" />
      <TextBox Name="PinBox" TextChanged="OnEndpointTextChanged" PlaceholderText="Optional lab certificate pin path (.cer/.crt)"
               AutomationProperties.Name="Certificate pin path" />

      <TextBlock Classes="caption" Text="PROFILE" Margin="0,6,0,0" />
      <CheckBox Name="SaveProfileBox" Content="Save profile (non-secret settings only)"
                IsCheckedChanged="OnSaveProfileChanged"
                AutomationProperties.Name="Save profile" />
      <TextBox Name="ProfileNameBox" PlaceholderText="Profile name" IsEnabled="False"
               AutomationProperties.Name="Profile name" />
      <CheckBox Name="RememberBox" Content="Remember password (macOS Keychain)" IsEnabled="False"
                AutomationProperties.Name="Remember password" />
      <TextBlock Name="KeychainNote" Classes="muted" FontSize="11" TextWrapping="Wrap" />

      <TextBlock Name="ErrorText" Classes="error" TextWrapping="Wrap" IsVisible="False" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
        <Button Content="Cancel" Click="OnCancel" AutomationProperties.Name="Cancel connect" />
        <Button Content="Connect" Classes="primary" Click="OnConnect" IsDefault="True"
                AutomationProperties.Name="Connect" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
