<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sqloryn.App"
             Name="SQLoryn"
             RequestedThemeVariant="Default">
  <!-- Name feeds the macOS application menu title (otherwise "Avalonia Application").
       RequestedThemeVariant=Default follows the live OS appearance; settings may override it. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- Neutral surfaces; accent comes from the OS (SystemControlHighlightAccentBrush). -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Sq.Bg" Color="#1E1E1E" />
          <SolidColorBrush x:Key="Sq.Panel" Color="#252526" />
          <SolidColorBrush x:Key="Sq.Raised" Color="#2C2C2E" />
          <SolidColorBrush x:Key="Sq.Hover" Color="#3A3A3C" />
          <SolidColorBrush x:Key="Sq.Border" Color="#3F3F42" />
          <SolidColorBrush x:Key="Sq.Text" Color="#E8E8EA" />
          <SolidColorBrush x:Key="Sq.Muted" Color="#9A9AA0" />
          <SolidColorBrush x:Key="Sq.Accent" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="Sq.OnAccent" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Sq.Danger" Color="#FF6961" />
          <SolidColorBrush x:Key="Sq.Warning" Color="#FFB340" />
          <SolidColorBrush x:Key="Sq.GridAlt" Color="#222224" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Sq.Bg" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Sq.Panel" Color="#F5F5F7" />
          <SolidColorBrush x:Key="Sq.Raised" Color="#ECECEE" />
          <SolidColorBrush x:Key="Sq.Hover" Color="#E0E0E3" />
          <SolidColorBrush x:Key="Sq.Border" Color="#D2D2D7" />
          <SolidColorBrush x:Key="Sq.Text" Color="#1D1D1F" />
          <SolidColorBrush x:Key="Sq.Muted" Color="#6E6E73" />
          <SolidColorBrush x:Key="Sq.Accent" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="Sq.OnAccent" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Sq.Danger" Color="#C5221F" />
          <SolidColorBrush x:Key="Sq.Warning" Color="#8F5900" />
          <SolidColorBrush x:Key="Sq.GridAlt" Color="#F7F7F9" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- No Accent override: Fluent takes the accent colour from the OS. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" RegionColor="#1E1E1E" ErrorText="#FF6961" />
        <ColorPaletteResources x:Key="Light" RegionColor="#FFFFFF" ErrorText="#C5221F" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource Sq.Bg}" />
      <Setter Property="Foreground" Value="{DynamicResource Sq.Text}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Surfaces -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource Sq.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sq.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.toolbar">
      <Setter Property="Background" Value="{DynamicResource Sq.Raised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sq.Border}" />
      <Setter Property="BorderThickness" Value="0,1,0,1" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Border.statusbar">
      <Setter Property="Background" Value="{DynamicResource Sq.Raised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sq.Border}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Border.sectionhead">
      <Setter Property="Background" Value="{DynamicResource Sq.Raised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sq.Border}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Rectangle.vsep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Fill" Value="{DynamicResource Sq.Border}" />
      <Setter Property="Margin" Value="6,2" />
    </Style>

    <!-- Typography -->
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Sq.Muted}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource Sq.Muted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.8" />
    </Style>
    <Style Selector="TextBlock.null">
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Foreground" Value="{DynamicResource Sq.Muted}" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource Sq.Danger}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Menlo, Monaco, Consolas, monospace" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="Menlo, Monaco, Consolas, monospace" />
    </Style>

    <!-- Menu -->
    <Style Selector="Menu">
      <Setter Property="Background" Value="{DynamicResource Sq.Panel}" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="{DynamicResource Sq.Text}" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Sq.Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Sq.Text}" />
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Sq.Border}" />
    </Style>
    <Style Selector="Button.tool:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Sq.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Sq.OnAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Sq.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Sq.OnAccent}" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource Sq.Danger}" />
      <Setter Property="Foreground" Value="{DynamicResource Sq.OnAccent}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="{DynamicResource Sq.Warning}" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TextBox.editor">
      <Setter Property="Background" Value="{DynamicResource Sq.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sq.Border}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- Tree -->
    <Style Selector="TreeView">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="2,1" />
    </Style>

    <!-- Tabs -->
    <Style Selector="TabControl">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,4" />
    </Style>

    <!-- Data grid -->
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="{DynamicResource Sq.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sq.Border}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="GridLinesVisibility" Value="All" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Sq.Border}" />
      <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Sq.Border}" />
      <Setter Property="RowBackground" Value="Transparent" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource Sq.Raised}" />
      <Setter Property="Foreground" Value="{DynamicResource Sq.Text}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Styles>
</Application>
