<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sqloryn.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="Sq.BgColor">#0E141B</Color>
          <SolidColorBrush x:Key="Sq.Bg" Color="#0E141B" />
          <SolidColorBrush x:Key="Sq.Panel" Color="#141C25" />
          <SolidColorBrush x:Key="Sq.Raised" Color="#1B2531" />
          <SolidColorBrush x:Key="Sq.Hover" Color="#223142" />
          <SolidColorBrush x:Key="Sq.Border" Color="#2A3A4C" />
          <SolidColorBrush x:Key="Sq.Text" Color="#D7E1EA" />
          <SolidColorBrush x:Key="Sq.Muted" Color="#7F93A8" />
          <SolidColorBrush x:Key="Sq.Accent" Color="#2DD4BF" />
          <SolidColorBrush x:Key="Sq.AccentDim" Color="#14766C" />
          <SolidColorBrush x:Key="Sq.OnAccent" Color="#04201C" />
          <SolidColorBrush x:Key="Sq.Danger" Color="#F87171" />
          <SolidColorBrush x:Key="Sq.GridAlt" Color="#111A23" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="Sq.BgColor">#EEF2F6</Color>
          <SolidColorBrush x:Key="Sq.Bg" Color="#EEF2F6" />
          <SolidColorBrush x:Key="Sq.Panel" Color="#F7F9FB" />
          <SolidColorBrush x:Key="Sq.Raised" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Sq.Hover" Color="#E1E8EF" />
          <SolidColorBrush x:Key="Sq.Border" Color="#C5D0DB" />
          <SolidColorBrush x:Key="Sq.Text" Color="#1E2A36" />
          <SolidColorBrush x:Key="Sq.Muted" Color="#5F7184" />
          <SolidColorBrush x:Key="Sq.Accent" Color="#0F766E" />
          <SolidColorBrush x:Key="Sq.AccentDim" Color="#14B8A6" />
          <SolidColorBrush x:Key="Sq.OnAccent" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Sq.Danger" Color="#B42318" />
          <SolidColorBrush x:Key="Sq.GridAlt" Color="#F3F6F9" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#2DD4BF" RegionColor="#0E141B"
                               ErrorText="#F87171" />
        <ColorPaletteResources x:Key="Light" Accent="#0F766E" RegionColor="#EEF2F6"
                               ErrorText="#B42318" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource Sq.Bg}" />
      <Setter Property="Foreground" Value="{DynamicResource Sq.Text}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Surfaces -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource Sq.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sq.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.toolbar">
      <Setter Property="Background" Value="{DynamicResource Sq.Raised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sq.Border}" />
      <Setter Property="BorderThickness" Value="0,1,0,1" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Border.statusbar">
      <Setter Property="Background" Value="{DynamicResource Sq.Raised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sq.Border}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Border.sectionhead">
      <Setter Property="Background" Value="{DynamicResource Sq.Raised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sq.Border}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Rectangle.vsep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Fill" Value="{DynamicResource Sq.Border}" />
      <Setter Property="Margin" Value="6,2" />
    </Style>

    <!-- Typography -->
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Sq.Muted}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource Sq.Muted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.8" />
    </Style>
    <Style Selector="TextBlock.null">
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Foreground" Value="{DynamicResource Sq.Muted}" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource Sq.Danger}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Menlo, Monaco, Consolas, monospace" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="Menlo, Monaco, Consolas, monospace" />
    </Style>

    <!-- Menu -->
    <Style Selector="Menu">
      <Setter Property="Background" Value="{DynamicResource Sq.Panel}" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="{DynamicResource Sq.Text}" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Sq.Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Sq.Text}" />
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Sq.Border}" />
    </Style>
    <Style Selector="Button.tool:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Sq.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Sq.OnAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Sq.AccentDim}" />
      <Setter Property="Foreground" Value="{DynamicResource Sq.OnAccent}" />
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource Sq.Danger}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="14,6" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TextBox.editor">
      <Setter Property="Background" Value="{DynamicResource Sq.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sq.Border}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- Tree -->
    <Style Selector="TreeView">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="2,1" />
    </Style>

    <!-- Tabs -->
    <Style Selector="TabControl">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,4" />
    </Style>

    <!-- Data grid -->
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="{DynamicResource Sq.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sq.Border}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="GridLinesVisibility" Value="All" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Sq.Border}" />
      <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Sq.Border}" />
      <Setter Property="RowBackground" Value="Transparent" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource Sq.Raised}" />
      <Setter Property="Foreground" Value="{DynamicResource Sq.Text}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Styles>
</Application>
