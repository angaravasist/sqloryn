<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sqloryn.SettingsWindow"
        Title="Settings — SQLoryn"
        Width="460" Height="430"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Name="PathText" Classes="muted" FontSize="11" TextWrapping="Wrap" />

    <TextBlock Classes="caption" Text="EDITOR" Margin="0,6,0,0" />
    <Grid ColumnDefinitions="160,*">
      <TextBlock Text="Font size" VerticalAlignment="Center" />
      <NumericUpDown Name="FontSizeBox" Grid.Column="1" Minimum="8" Maximum="48" Increment="1"
                     FormatString="0" AutomationProperties.Name="Editor font size" />
    </Grid>

    <TextBlock Classes="caption" Text="RESULTS" Margin="0,6,0,0" />
    <Grid ColumnDefinitions="160,*">
      <TextBlock Text="Max rows displayed" VerticalAlignment="Center" />
      <NumericUpDown Name="MaxRowsBox" Grid.Column="1" Minimum="1" Maximum="5000" Increment="500"
                     FormatString="0" AutomationProperties.Name="Maximum displayed rows" />
    </Grid>
    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
               Text="Each result set keeps at most 5,000 rows (retained). This setting limits how many retained rows the grid draws. When a set is cut off, its tab says so: the server's total row count is not known, and exports contain only retained rows." />

    <TextBlock Classes="caption" Text="SAFETY" Margin="0,6,0,0" />
    <CheckBox Name="ConfirmBox" IsChecked="True" IsEnabled="False"
              Content="Confirm destructive operations (always on in this preview)" />

    <TextBlock Classes="caption" Text="APPEARANCE" Margin="0,6,0,0" />
    <ComboBox Name="ThemeBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Theme" />

    <TextBlock Name="ErrorText" Classes="error" TextWrapping="Wrap" IsVisible="False" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="Cancel" Click="OnCancel" />
      <Button Content="Save" Classes="primary" Click="OnSave" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
